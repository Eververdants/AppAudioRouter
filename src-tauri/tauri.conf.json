{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "App Audio Router",
  "version": "2.1.0",
  "identifier": "com.eververdants.app-audio-router",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Audio Router",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": []
  }
}
