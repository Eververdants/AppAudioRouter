{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "App Audio Router",
  "version": "2.0.0",
  "identifier": "com.eververdants.app-audio-router",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Audio Router",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "shell": {
      "scope": []
    },
    "store": {
      "path": "app-audio-router.json"
    }
  }
}
